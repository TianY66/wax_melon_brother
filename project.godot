; Engine configuration file.
config_version=5

[application]
config/name="Winter Melon Brothers"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="winter_melon_brothers"

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
ConfigRepo="*res://scripts/autoload/config_repo.gd"
SaveService="*res://scripts/autoload/save_service.gd"
AudioService="*res://scripts/autoload/audio_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

